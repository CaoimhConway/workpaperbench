  "claim_assertions": {
    "quarter_ratio_equals_ttm": "Dividing Q4FY2025 transactions by December active accounts reproduces the issuer trailing-twelve-month activity measure.",
    "unique_people_identifiable": "The supplied account counts identify the exact number of distinct people using PayPal.",
    "annual_ex_interest_margin_dollars_increased": "Annual transaction margin dollars excluding customer interest increased from FY2024 to FY2025."
  },
  "definitions": {
    "quarter_activity": "Quarter flows are divided by active accounts at period end. Keep the reported trailing-year ratio alongside the distinct quarterly calculation.",
    "margin_reconciliation": "Margin dollars equal net revenue less transaction expense and transaction/credit losses. Ex-interest subtracts customer-balance interest. Percent margins use net revenue.",
    "annual_activity_bridge": "FY2025 sums only its four quarters and uses Q4 end accounts for trailing-year activity. Activity residual is recomputed less reported rounded ratio. Revenue residual is transaction plus OVAS less net revenue."
